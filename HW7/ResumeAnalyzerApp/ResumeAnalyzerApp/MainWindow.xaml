<Window x:Class="ResumeAnalyzerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResumeAnalyzerApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">

            <Button Content="Завантажити файл"
            Click="LoadOne_Click"
            Height="30"/>

            <Button Content="Завантажити папку"
            Click="LoadFolder_Click"
            Height="30"
            Margin="0,5,0,0"/>

            <ComboBox x:Name="cityBox"
              Height="25"
              Margin="0,5,0,0"/>

            <Button Content="Показати по місту"
            Click="CityReport_Click"
            Height="30"/>

            <TextBox x:Name="resultBox"
             Margin="0,10,0,0"
             Height="200"
             AcceptsReturn="True"
             TextWrapping="Wrap"/>
            <Button Content="Найдосвідченіший"
                Click="MostExperienced_Click"
                Height="30"/>

            <Button Content="Найменш досвідчений"
                Click="LeastExperienced_Click"
                Height="30"/>

            <Button Content="Min зарплата"
                Click="MinSalary_Click"
                Height="30"/>

            <Button Content="Max зарплата"
                Click="MaxSalary_Click"
                Height="30"/>

            <Button Content="Очистити"
                Click="Clear_Click"
                Height="30"/>

        </StackPanel>
    </Grid>
</Window>
